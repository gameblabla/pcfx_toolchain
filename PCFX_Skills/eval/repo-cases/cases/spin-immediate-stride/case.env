# Optional exact-output integration case. Supply a compatible character-renderer
# source tree with PCFX_EVAL_SOURCE. Its wrapper must put V810 tools on PATH, run the
# target's PC-FX Makefile, then call bincat and pcfx-cdlink; do not substitute bare make.
SOURCE=
BUILD_CMD=./build_with_toolchain.sh "$V810_GCC" clean all
CUE=game.cue
FRAMES=2400
REFERENCE=reference.png
MAX_DIFF_PIXELS=0
